FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
# Preserve upstream dependency pins while replacing the CUDA torch dependency tree.
RUN uv export --frozen --no-dev --extra serve --no-emit-project --prune torch -o /tmp/requirements.txt \
    && uv pip install --system --index-url https://download.pytorch.org/whl/cpu torch==2.8.0 \
    && uv pip install --system -r /tmp/requirements.txt
COPY kev/ kev/
RUN useradd --create-home --uid 10001 kev && mkdir /models && chown kev:kev /models
ENV KEV_HOST=0.0.0.0 HF_HOME=/models PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER kev
EXPOSE 8008
CMD ["python", "-m", "kev.serve", "--run", "jaredpalmer/kev-0.5b", "--port", "8008"]
